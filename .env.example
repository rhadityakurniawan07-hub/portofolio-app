# Kontak (opsional — tanpa ini pesan tetap tersimpan di database,
# tetapi pengunjung akan melihat status "tersimpan, notifikasi belum terkirim")
# Daftar gratis di https://resend.com, lalu isi key + email tujuan
RESEND_API_KEY=""
CONTACT_TO_EMAIL="kamu@contoh.id"
CONTACT_FROM_EMAIL="Portofolio <onboarding@resend.dev>"

# Notifikasi WhatsApp (pilih salah satu provider)
# callmebot: gratis, kirim ke nomor pemilik. Aktifkan lewat situs CallMeBot.
WHATSAPP_PROVIDER=""
CALLMEBOT_PHONE="628xxxxxxxxxx"
CALLMEBOT_APIKEY=""

# fonnte: berbayar, lebih andal untuk production
FONNTE_TOKEN=""
FONNTE_TARGET="628xxxxxxxxxx"