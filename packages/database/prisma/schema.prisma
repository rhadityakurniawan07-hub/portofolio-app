generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(cuid())
  fullName      String
  role          String
  tagline       String
  location      String
  email         String   @unique
  availability  String
  skills        String[]
  languages     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("profiles")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[]
  link        String?
  year        String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}