generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id              String   @id @default(cuid())
  fullName        String
  role            String
  tagline         String
  bio             String
  location        String
  email           String   @unique
  availability    String
  availabilityStatus String @default("available")
  phone           String?
  photoUrl        String?
  github          String?
  linkedin        String?
  twitter         String?
  whatsapp        String?
  telegram        String?
  skills          String[]
  languages       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[]
  projectUrl  String?
  githubUrl   String?
  year        String
  category    String
  status      String   @default("Production")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}